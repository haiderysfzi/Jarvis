# PostgreSQL connection (required)
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# LLM provider: "anthropic", "openai", or "ollama"
JARVIS_PROVIDER=anthropic

# Provider API keys (set the one matching your provider)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# For Ollama (local models, no key needed)
OLLAMA_BASE_URL=http://localhost:11434

# Optional overrides
JARVIS_MODEL=              # e.g. claude-sonnet-4-20250514, gpt-4o, llama3.1
JARVIS_READ_ONLY=false     # true to block all write operations
